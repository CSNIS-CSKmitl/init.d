# PocketBase FCM Push Relay Environment Configuration
# Place at: /etc/pocketbase-push-relay.env with permissions 600 (chmod 600 /etc/pocketbase-push-relay.env)

# Path to the Firebase service account private key JSON file
FIREBASE_SERVICE_ACCOUNT_PATH=/opt/push_relay/firebase-service-account.json

# Secret key shared between PocketBase pb_hooks and Push Relay (minimum 32 characters)
PUSH_RELAY_SECRET=change-this-to-a-secure-random-32-char-secret-string-here

# Port for the local relay daemon to listen on (default: 8181)
PUSH_RELAY_PORT=8181
